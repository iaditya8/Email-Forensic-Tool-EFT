# ==============================================================================
# Email Forensic Tool (EFT) — Environment Configuration
# ==============================================================================

# MaxMind GeoLite2 Offline Database Paths (Air-Gapped IP & ASN Enrichment)
# Download from: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_CITY_DB="data/geoip/GeoLite2-City.mmdb"
GEOIP_ASN_DB="data/geoip/GeoLite2-ASN.mmdb"

# Threat Intelligence & Watchlist Defaults
DEFAULT_IOC_FILE="iocs.txt"
DEFAULT_WATCHLIST_FILE="watchlist.json"

# Server Configuration (eft serve)
EFT_SERVER_HOST="127.0.0.1"
EFT_SERVER_PORT=8000

# Comma-separated CORS origins for split deployment (frontend + backend on different hosts)
# Example: "https://your-frontend.vercel.app,https://staging.your-frontend.vercel.app"
EFT_CORS_ALLOW_ORIGINS="http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173"
